{
  "name": "capital-os",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Capital OS — личный инструмент для решений о деньгах (PWA, всё на клиенте)",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base ./",
    "preview": "vite preview",
    "app": "vite build && vite preview --port 5173 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=engine/** --coverage.thresholds.lines=90",
    "typecheck": "tsc --noEmit",
    "test:bun": "bun test",
    "dev:bun": "bun scripts/dev-server.ts",
    "fixtures": "bun scripts/make-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
